{
  "version": 2,
  "groups": [
    {
      "id": "cn",
      "name": "中国大陆",
      "description": "中国大陆站点本地直连，其余流量走代理（回路由器）",
      "regions": ["CN"],
      "default": true,
      "rules": [
        { "type": "geosite", "value": "cn", "action": "direct" },
        { "type": "geoip", "value": "cn", "action": "direct" },
        { "type": "domainSuffix", "value": "cn", "action": "direct" },
        { "type": "domainSuffix", "value": "hk", "action": "direct" }
      ],
      "catchAll": "proxy",
      "dns": {
        "direct": "wan", "directProtocol": "udp", "directPort": 53, "directExtras": [],
        "proxy": "1.1.1.1", "proxyProtocol": "tcp", "proxyPort": 53, "proxyExtras": []
      }
    },
    {
      "id": "hkmo",
      "name": "香港澳门",
      "description": "AI 服务等通过代理（回路由器）访问，其余流量本地直连",
      "regions": ["HK", "MO"],
      "rules": [
        { "type": "geosite", "value": "category-ai-!cn", "action": "proxy" },
        { "type": "geosite", "value": "bytedance-ai-!cn", "action": "proxy" },
        { "type": "domainSuffix", "value": "muse.ai", "action": "proxy" }
      ],
      "catchAll": "direct",
      "dns": {
        "direct": "wan", "directProtocol": "udp", "directPort": 53, "directExtras": [],
        "proxy": "wan", "proxyProtocol": "udp", "proxyPort": 53, "proxyExtras": []
      }
    },
    {
      "id": "other",
      "name": "其他地区",
      "description": "中国大陆（不含香港、澳门）站点走代理（回路由器），其余流量本地直连",
      "regions": ["CN", "HK", "MO"],
      "regionMatch": "outside",
      "rules": [
        { "type": "geosite", "value": "cn", "action": "proxy" },
        { "type": "geoip", "value": "cn", "action": "proxy" }
      ],
      "catchAll": "direct",
      "dns": {
        "direct": "wan", "directProtocol": "udp", "directPort": 53, "directExtras": [],
        "proxy": "wan", "proxyProtocol": "udp", "proxyPort": 53, "proxyExtras": []
      }
    }
  ]
}
