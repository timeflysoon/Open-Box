# Open-Box 面板(Debian / Ubuntu)。对应 OpenWrt 的 /etc/init.d/openbox-panel:procd 的 respawn 3600 5 0(不限次数)
# 换成 Restart=always 且不限流;端口 / 堆上限在 debian/bin/openbox-panel-run 里算。PATH 最前面是 logread 替身所在目录
[Unit]
Description=Open-Box panel
Documentation=https://github.com/liandu2024/Open-Box
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/opt/open-box/debian/bin/openbox-panel-run
WorkingDirectory=/opt/open-box
Restart=always
RestartSec=3
Environment=PATH=/opt/open-box/debian/shim:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
