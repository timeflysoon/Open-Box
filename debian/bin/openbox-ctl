#!/bin/sh
# Open-Box sing-box 内核在 Debian / Ubuntu(systemd)上的服务控制脚本,对应 OpenWrt 的 openwrt/initd/openbox。
#
# 面板(panel/server/system/service.mjs)只认 start / stop / restart / enable / disable / enabled / status 这几个动作,
# 这里逐个翻译成 systemctl。pre-start / post-stop 两个动作由 openbox.service 的 ExecStartPre / ExecStopPost 调用,
# 做的事和 OpenWrt 脚本 start_service / openbox_cleanup 里与 dnsmasq、uci 无关的部分一致:加载 auto_redirect 用到的
# nft 模块、清掉上次没删干净的 inet sing-box 表、装 Open-Box 自己的 inet openbox 表(进内核前放行)、给内核自身流量的
# 标记补一条终止查找的策略路由、打开转发。下面几个 openbox_* 函数的正文和 OpenWrt 脚本保持一致,改一处记得改另一处。
#
# 这里没有 dnsmasq 接管和 uci 防火墙:Debian 上 DNS 只有劫持模式(面板会隐藏 dnsmasq 分流),防火墙由用户自理。

UNIT=openbox.service
OPENBOX_ROOT=/opt/open-box
. "$OPENBOX_ROOT/openwrt/bin/openbox-kernel"
DATA="$OPENBOX_ROOT/data"
# sing-box 自己流量的 fwmark(tun 的 auto_redirect_output_mark 默认值),见 OpenWrt 脚本
SINGBOX_OUTPUT_MARK=0x2024
# Open-Box 的放行位(内核 tcp15 起认):进内核前放行的流量只按位或上这一位,交给系统自己的路由,见 OpenWrt 脚本
OPENBOX_PASS_MARK=0x02000000
NFT_TABLE="inet openbox"
OPENBOX_MARK_RULE_PREF=8999
OPENBOX_PASS_RULE_PREF=8998
OPENBOX_PASS_SKIP_TO=9010
OPENBOX_PASS_LAST_PREF=32767
# 起内核前 ip_forward 的原值:是我们打开的才在停止时关回去,用户本来就开着的不动
FORWARD_STATE="$DATA/ip-forward.prev"

# 进内核之前就放行的端口 / 终端(GitHub #183 #187):面板部署时生成的 nft 链正文(不含 table 外壳,
# server/system/entry-bypass.mjs)。只认规则里会出现的字符,混进别的东西整份不装
ENTRY_BYPASS="$OPENBOX_ROOT/etc/entry-bypass.nft"
openbox_entry_bypass() {
	[ -s "$ENTRY_BYPASS" ] || return 0
	grep -q '[^A-Za-z0-9 	{}.,:;!="_@/-]' "$ENTRY_BYPASS" && return 0
	cat "$ENTRY_BYPASS"
}

# Open-Box 自己的 nft 表(inet openbox),起内核前按需整张重建;都不需要就不建。
# Debian 上没有 dnsmasq 分流,表里只有面板生成的进内核前放行链
# Replace the owned table in one nft transaction. A separate delete opens a
# window where old DNAT conntracks can send TUN DNS to the default WAN route.
openbox_replace_nft() {
	_ob_tmp="/tmp/openbox-nft-$$.tmp"
	_ob_err="/tmp/openbox-nft-err-$$.tmp"
	_ob_head="/tmp/openbox-nft-head-$$.tmp"
	_ob_tail="/tmp/openbox-nft-tail-$$.tmp"
	_ob_elems="/tmp/openbox-nft-elems-$$.tmp"
	_ob_batch="/tmp/openbox-nft-batch-$$.tmp"
	_ob_old_rmem=""
	_ob_del=""
	nft list table $NFT_TABLE >/dev/null 2>&1 && _ob_del="delete table $NFT_TABLE"
	{
		[ -n "$_ob_del" ] && printf '%s\n' "$_ob_del"
		cat
	} > "$_ob_tmp"
	if nft -f - < "$_ob_tmp" 2>"$_ob_err"; then
		rm -f "$_ob_tmp" "$_ob_err"
		return 0
	fi
	if grep -qi 'No buffer space available' "$_ob_err" 2>/dev/null && [ -w /proc/sys/net/core/rmem_default ]; then
		_ob_cur_rmem="$(cat /proc/sys/net/core/rmem_default 2>/dev/null)"
		_ob_max_rmem="$(cat /proc/sys/net/core/rmem_max 2>/dev/null)"
		if [ -n "$_ob_cur_rmem" ] && [ "$_ob_cur_rmem" -lt 16777216 ] 2>/dev/null; then
			[ -n "$_ob_max_rmem" ] && [ "$_ob_max_rmem" -lt 16777216 ] 2>/dev/null && echo 16777216 > /proc/sys/net/core/rmem_max 2>/dev/null
			if echo 16777216 > /proc/sys/net/core/rmem_default 2>/dev/null; then
				_ob_old_rmem="$_ob_cur_rmem"
			fi
		fi
		if [ -n "$_ob_old_rmem" ] && ! grep -q 'elements = {' "$_ob_tmp"; then
			if nft -f - < "$_ob_tmp" 2>/dev/null; then
				echo "$_ob_old_rmem" > /proc/sys/net/core/rmem_default 2>/dev/null
				rm -f "$_ob_tmp" "$_ob_err"
				return 0
			fi
		fi
	fi
	cat "$_ob_err" >&2 2>/dev/null
	rm -f "$_ob_err"
	if ! grep -q 'elements = {' "$_ob_tmp"; then
		[ -n "$_ob_old_rmem" ] && echo "$_ob_old_rmem" > /proc/sys/net/core/rmem_default 2>/dev/null
		rm -f "$_ob_tmp"
		return 1
	fi
	awk -v tbl="$NFT_TABLE" -v headf="$_ob_head" -v tailf="$_ob_tail" -v elemf="$_ob_elems" '
		BEGIN { in_set = ""; in_tail_chain = 0 }
		/^delete table / { print > headf; next }
		/^table / { print > headf; next }
		/^\tset [A-Za-z0-9_]+ [{]/ {
			s = $0; sub(/^\tset /, "", s); sub(/ [{].*/, "", s); in_set = s
			print > headf; next
		}
		in_set != "" && /^\t\telements = [{]/ {
			body = $0; sub(/^\t\telements = [{][ \t]*/, "", body); sub(/[ \t]*[}].*/, "", body)
			n = split(body, items, /,[ \t]*/)
			for (i = 1; i <= n; i += 256) {
				chunk = ""
				for (j = i; j <= n && j < i + 256; j++) {
					if (items[j] == "") continue
					chunk = (chunk == "" ? items[j] : chunk ", " items[j])
				}
				if (chunk != "") printf "add element %s %s { %s }\n", tbl, in_set, chunk > elemf
			}
			next
		}
		in_set != "" && /^\t[}]$/ { in_set = ""; print > headf; next }
		/^\tchain (entry_bypass_in|entry_bypass_out|tcp_mss_out|terminal_dns) [{]/ {
			in_tail_chain = 1; print > tailf; next
		}
		in_tail_chain {
			print > tailf
			if (/^\t[}]$/) in_tail_chain = 0
			next
		}
		{ print > headf }
		END { close(headf); close(tailf); close(elemf) }
	' "$_ob_tmp"
	_ob_rc=0
	nft -f - < "$_ob_head" || _ob_rc=1
	if [ "$_ob_rc" -eq 0 ] && [ -s "$_ob_elems" ]; then
		while IFS= read -r _ob_line; do
			[ -n "$_ob_line" ] || continue
			printf '%s\n' "$_ob_line" > "$_ob_batch"
			nft -f - < "$_ob_batch" || { _ob_rc=1; break; }
		done < "$_ob_elems"
	fi
	if [ "$_ob_rc" -eq 0 ] && [ -s "$_ob_tail" ]; then
		{
			printf 'table %s {\n' "$NFT_TABLE"
			cat "$_ob_tail"
			printf '}\n'
		} > "$_ob_batch"
		nft -f - < "$_ob_batch" || _ob_rc=1
	fi
	[ -n "$_ob_old_rmem" ] && echo "$_ob_old_rmem" > /proc/sys/net/core/rmem_default 2>/dev/null
	rm -f "$_ob_tmp" "$_ob_head" "$_ob_tail" "$_ob_elems" "$_ob_batch"
	return $_ob_rc
}

# Stop removes interception/marks but retains the inert TUN DNS egress guard:
# DNAT conntracks can survive both the core and its routes. Uninstall removes it.
openbox_clear_nft() {
	command -v nft >/dev/null 2>&1 || return 0
	_ob_guard="$(nft -s list chain $NFT_TABLE terminal_dns_egress 2>/dev/null; nft -s list chain $NFT_TABLE terminal_dns_forward 2>/dev/null)"
	printf '%s\n' "$_ob_guard" | openbox_replace_nft >/dev/null 2>&1 || {
		nft delete table $NFT_TABLE >/dev/null 2>&1 && return 0
		echo "openbox: failed to clear interception in nft table $NFT_TABLE" >&2
		return 1
	}
}

openbox_apply_nft() {
	command -v nft >/dev/null 2>&1 || return 0
	_ob_entry="$(openbox_entry_bypass)"
	[ -n "$_ob_entry" ] || { openbox_clear_nft; return $?; }
	_ob_guard=""
	for _ob_chain in terminal_dns_egress terminal_dns_forward; do
		case "$_ob_entry" in
			*"chain $_ob_chain"*) ;;
			*) _ob_guard="$_ob_guard
$(nft -s list chain $NFT_TABLE "$_ob_chain" 2>/dev/null | sed '1d;$d')" ;;
		esac
	done
	{
		echo "table $NFT_TABLE {"
		echo "$_ob_entry"
		[ -n "$_ob_guard" ] && echo "$_ob_guard"
		echo "}"
	} | openbox_replace_nft >/dev/null 2>&1 || { echo "openbox: failed to install nft table $NFT_TABLE" >&2; return 1; }
}

# auto_redirect 在 nft 里用到的表达式各自是一个内核模块(queue / nat / redir / tproxy / socket / fib),
# 重启后没人加载它们,nft 提交规则时内核找不到模块就回 ENOENT(GitHub #225)。起内核前挨个 modprobe 一遍
openbox_load_modules() {
	for _ob_mod in tun nft_queue nft_nat nft_redir nft_tproxy nft_socket nft_fib_inet nft_ct; do
		[ -d "/sys/module/$_ob_mod" ] || modprobe "$_ob_mod" >/dev/null 2>&1
	done
}

# 内核的 auto_redirect 会自己建一张 inet sing-box / inet mihomo 表,被强杀 / OOM 时不会删,下次启动撞上就 FATAL(file exist)。
# 只在没有任何对应内核进程在跑时才清:机器上要是还跑着别的实例,那张表是它的
openbox_clean_stale_nft() {
	command -v nft >/dev/null 2>&1 || return 0
	if ! pgrep -x sing-box >/dev/null 2>&1 && nft list table inet sing-box >/dev/null 2>&1; then
		echo "openbox: removing stale nftables table left by a previous kernel run" >&2
		nft delete table inet sing-box >/dev/null 2>&1
	fi
	if ! pgrep -x mihomo >/dev/null 2>&1 && nft list table inet mihomo >/dev/null 2>&1; then
		echo "openbox: removing stale nftables table left by a previous mihomo run" >&2
		nft delete table inet mihomo >/dev/null 2>&1
	fi
	return 0
}

# 给内核自身流量的标记补一条终止查找的策略路由(GitHub #157),再给放行位补两条不进 tun 表的,说明见 OpenWrt 脚本
openbox_apply_mark_rule() {
	command -v ip >/dev/null 2>&1 || return 0
	openbox_clear_mark_rule
	ip rule add pref $OPENBOX_MARK_RULE_PREF fwmark $SINGBOX_OUTPUT_MARK lookup main >/dev/null 2>&1
	ip -6 rule add pref $OPENBOX_MARK_RULE_PREF fwmark $SINGBOX_OUTPUT_MARK lookup main >/dev/null 2>&1
	for _ob_ip in "ip" "ip -6"; do
		$_ob_ip rule add pref $OPENBOX_PASS_RULE_PREF fwmark $OPENBOX_PASS_MARK/$OPENBOX_PASS_MARK goto $OPENBOX_PASS_SKIP_TO >/dev/null 2>&1
		$_ob_ip rule add pref $OPENBOX_PASS_LAST_PREF fwmark $OPENBOX_PASS_MARK/$OPENBOX_PASS_MARK unreachable >/dev/null 2>&1
	done
	return 0
}

openbox_clear_mark_rule() {
	command -v ip >/dev/null 2>&1 || return 0
	while ip rule del pref $OPENBOX_MARK_RULE_PREF >/dev/null 2>&1; do :; done
	while ip -6 rule del pref $OPENBOX_MARK_RULE_PREF >/dev/null 2>&1; do :; done
	# 32767 上还有系统自己的 lookup default:只按放行位那条的条件删,不能光按优先级删
	for _ob_ip in "ip" "ip -6"; do
		while $_ob_ip rule del pref $OPENBOX_PASS_RULE_PREF fwmark $OPENBOX_PASS_MARK/$OPENBOX_PASS_MARK >/dev/null 2>&1; do :; done
		while $_ob_ip rule del pref $OPENBOX_PASS_LAST_PREF fwmark $OPENBOX_PASS_MARK/$OPENBOX_PASS_MARK unreachable >/dev/null 2>&1; do :; done
	done
	return 0
}

# 旁路由用法要靠这台机器转发局域网终端的包(OpenWrt 作为路由器本来就开着);Debian 桌面 / 服务器默认是关的。
# 记下原值,停止时是我们开的才关回去
openbox_enable_forward() {
	_ob_v4="$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null)"
	if [ "$_ob_v4" = "0" ]; then
		mkdir -p "$DATA"
		printf 'ipv4=0\n' > "$FORWARD_STATE"
		sysctl -q -w net.ipv4.ip_forward=1 >/dev/null 2>&1
	fi
	# 配置里 tun 带 IPv6 地址才需要 v6 转发
	if grep -q '"inet6_address"' "$CONF" 2>/dev/null ||
		{ [ "$OPENBOX_KERNEL" = mihomo ] && grep -q '"ipv6": *true' "$CONF" 2>/dev/null; }; then
		_ob_v6="$(cat /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null)"
		if [ "$_ob_v6" = "0" ]; then
			mkdir -p "$DATA"
			printf 'ipv6=0\n' >> "$FORWARD_STATE"
			sysctl -q -w net.ipv6.conf.all.forwarding=1 >/dev/null 2>&1
		fi
	fi
	return 0
}

openbox_restore_forward() {
	[ -f "$FORWARD_STATE" ] || return 0
	grep -q '^ipv4=0' "$FORWARD_STATE" && sysctl -q -w net.ipv4.ip_forward=0 >/dev/null 2>&1
	grep -q '^ipv6=0' "$FORWARD_STATE" && sysctl -q -w net.ipv6.conf.all.forwarding=0 >/dev/null 2>&1
	rm -f "$FORWARD_STATE"
	return 0
}

pre_start() {
	openbox_kernel_ready || return 1
	[ -e /dev/net/tun ] || modprobe tun >/dev/null 2>&1
	openbox_clean_stale_nft
	openbox_load_modules
	if [ "$OPENBOX_KERNEL" = sing-box ]; then
		openbox_apply_nft
		openbox_apply_mark_rule
	else
		ENTRY_BYPASS="$OPENBOX_ROOT/etc/mihomo-entry-bypass.nft"
		if [ -s "$ENTRY_BYPASS" ]; then
			command -v nft >/dev/null 2>&1 && [ -n "$(openbox_entry_bypass)" ] && openbox_apply_nft || return 1
		fi
	fi
	openbox_enable_forward
	return 0
}

# 停止后撤标记路由,清掉已退出内核崩溃/强杀残留的 inet sing-box / inet mihomo 表(由 ! pgrep -x 保护,不误伤其他实例),
# 再撤接管/标记(只保留旧 TUN DNS 出站保护),关回转发
post_stop() {
	openbox_clear_mark_rule
	openbox_clean_stale_nft
	openbox_clear_nft
	openbox_restore_forward
	return 0
}

case "$1" in
	pre-start) pre_start ;;
	post-stop) post_stop ;;
	# 连续崩溃触发 systemd 的启动限流后,单位处于 failed,不先 reset-failed 的话 start 会被拒(start request repeated too quickly)
	start|restart) systemctl reset-failed "$UNIT" >/dev/null 2>&1; exec systemctl "$1" "$UNIT" ;;
	stop|reload) exec systemctl "$1" "$UNIT" ;;
	enable|disable) exec systemctl -q "$1" "$UNIT" ;;
	enabled) exec systemctl -q is-enabled "$UNIT" ;;
	running) exec systemctl -q is-active "$UNIT" ;;
	# 面板判断"在跑"只看输出里有没有 running(且退出码 0),和 OpenWrt 的 rc.common status 一致
	status)
		if systemctl -q is-active "$UNIT"; then
			echo "running"
			exit 0
		fi
		echo "inactive"
		exit 3
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload|enable|disable|enabled|running|status}" >&2
		exit 1
		;;
esac
